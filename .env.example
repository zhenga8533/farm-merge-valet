# Copy to .env and adjust as needed. All variables are prefixed FMV_.

# Substring used to find the target application window (e.g. "Discord",
# your browser's window title, etc.) since the game can run inside several
# different host apps.
FMV_WINDOW_TITLE=r/FarmMergeValley

# Chrome remote-debugging port (see src/farm_merge_valet/cdp/client.py) --
# the bot reads the game's live camera state directly from the page's JS
# context instead of inferring it from screenshots. Requires launching
# Chrome with --remote-debugging-port=<this value> and a non-default
# --user-data-dir (Chrome refuses to enable debugging on your normal
# profile as a security measure).
FMV_CDP_PORT=9222

# Minimum confidence (0-1) required for a template match to be accepted.
FMV_MATCH_CONFIDENCE=0.85

# Board scanning checks "is this cell occupied?" against a handful of
# background tile templates before classifying which item is there --
# much cheaper than sweeping every item template over the whole frame.
# FMV_OCCUPANCY_THRESHOLD is how confidently a cell must match a known
# background to be treated as empty. Parallelized across
# FMV_BOARD_SCAN_WORKERS threads.
FMV_OCCUPANCY_THRESHOLD=0.6
FMV_BOARD_SCAN_WORKERS=8

# Fixed UI chrome bounding box, in captured-frame pixels -- excluded from
# scanning entirely. Above FMV_BOARD_MIN_PIXEL_Y is the browser tabs/
# address bar; left of FMV_BOARD_MIN_PIXEL_X/right of
# FMV_BOARD_MAX_PIXEL_X are the level-badge and settings/currency icon
# columns. Tuned to this specific window layout; adjust if the game is
# hosted differently.
FMV_BOARD_MIN_PIXEL_X=200
FMV_BOARD_MAX_PIXEL_X=1700
FMV_BOARD_MIN_PIXEL_Y=170

# Fallback-only now (see FMV_NEED_SPACE_CONFIDENCE below): board-full
# detection primarily reads the live game state directly, not vision.
# How many supply-crate clicks fire per re-sync/board-full check, and the
# delay between each click.
FMV_CRATE_CLICK_BATCH_SIZE=10
FMV_CRATE_CLICK_SETTLE=0.1

# Confidence threshold for the on-screen "Need more empty space!" banner
# -- only used as a fallback for whenever the live board-state read (see
# src/farm_merge_valet/cdp/board_store.py) hasn't been captured yet.
FMV_NEED_SPACE_CONFIDENCE=0.8

# Seconds between bot loop iterations.
FMV_LOOP_INTERVAL=1.0

# Default merge-5 preference: merging exactly 5 identical items yields 2 of
# the next tier instead of 1 from a merge-3 (see docs/game-mechanics.md).
FMV_PREFER_MERGE_FIVE=false

# Global hotkeys (active even when the terminal isn't focused) to
# pause/resume and quit the bot loop.
FMV_PAUSE_HOTKEY=f9
FMV_QUIT_HOTKEY=f10

# Start paused (press FMV_PAUSE_HOTKEY to begin) instead of acting
# immediately -- nothing touches the game, including the initial
# zoom-out/scroll-to-bottom setup, until you resume.
FMV_START_PAUSED=true

# Discord webhook URL for posting run statistics (optional).
FMV_DISCORD_WEBHOOK_URL=

FMV_LOG_LEVEL=INFO

# Overlay GUI (see src/farm_merge_valet/gui/overlay.py) -- a log viewer
# window, off by default. FMV_GUI_OVERLAY_MODE makes it always-on-top and
# click-through *while inactive* (alt-tab/click its taskbar entry to
# interact with it normally); disable it for a plain window instead.
# FMV_GUI_OPACITY is 0 (fully transparent) - 1 (fully opaque).
FMV_GUI_ENABLED=true
FMV_GUI_OPACITY=0.85
FMV_GUI_OVERLAY_MODE=true
