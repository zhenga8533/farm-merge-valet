# Copy to .env and adjust as needed. All variables are prefixed FMV_.

# Distinctive substring used to select the Reddit page CDP target.
FMV_WINDOW_TITLE=r/FarmMergeValley

# Managed browser. Chrome and Edge are supported; Brave and Chromium are
# experimental. `auto` prefers Chrome, then Edge. Uncomment the path settings
# to select a specific executable or dedicated profile directory.
FMV_BROWSER=auto
FMV_BROWSER_AUTO_LAUNCH=true
# FMV_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# FMV_BROWSER_PROFILE_DIR=C:\Users\you\AppData\Local\FarmMergeValet\BrowserProfiles\chrome
FMV_GAME_URL=https://www.reddit.com/r/FarmMergeValley/

# Managed-browser remote-debugging port (see src/farm_merge_valet/cdp/client.py).
# `browser launch` supplies this port, a dedicated profile, and all required
# background switches automatically.
FMV_CDP_PORT=9222

# Asset locations. Relative paths are resolved from the working directory.
# Optional overrides. By default these use the OS per-user cache directory.
# FMV_CATALOG_DIR=C:\path\to\local\catalog
# FMV_ATLAS_CACHE_DIR=C:\path\to\local\atlases

# Empty cells kept available when productive merge work exists. Set to 0 to
# disable the reserve; recognized-item swaps may still recover a full board.
FMV_MERGE_EMPTY_CELL_RESERVE=1

# Minimum open cells required before harvesting a ready tier-4 crop or animal.
FMV_PRODUCER_CLAIM_MIN_EMPTY_CELLS=4

# Seconds between bot loop iterations.
FMV_LOOP_INTERVAL=1.0

# Idle polling interval when no action can currently be planned. Set to 0 to
# keep using FMV_LOOP_INTERVAL. Unchanged idle states are not logged each poll.
FMV_IDLE_WAIT_SECONDS=30.0

# Action cadence. Item delays apply after a resolved item action; crate delays
# stay short because repeated supply claims are normal gameplay.
FMV_ITEM_ACTION_DELAY_MIN=1.5
FMV_ITEM_ACTION_DELAY_MAX=3.5
FMV_CRATE_DELAY_MIN=0.05
FMV_CRATE_DELAY_MAX=0.2

# Item families are enabled for merge-5 by default. Per-policy-key JSON
# overrides replace only the fields they specify. `always_remove` reserves the
# destructive-action preference for the future shovel feature; it is not acted
# on yet and should remain false.
FMV_ITEM_POLICY_DEFAULTS={"enabled":true,"prefer_merge_five":true,"always_remove":false}
FMV_ITEM_POLICY_OVERRIDES={}
# Example: allow merge-3 for cows and disable wheat automation.
# FMV_ITEM_POLICY_OVERRIDES={"animals/cow":{"prefer_merge_five":false},"crops/wheat":{"enabled":false}}

# Shop orders are enabled for all current and future catalog entries by
# default. Per-ID JSON overrides take precedence over the global defaults.
FMV_SHOP_DEFAULT_ENABLED=true
FMV_RECIPE_DEFAULT_ENABLED=true
FMV_SHOP_OVERRIDES={}
FMV_RECIPE_OVERRIDES={}
# Example: disable one entire shop and one recipe in another shop.
# FMV_SHOP_OVERRIDES={"bakery":false}
# FMV_RECIPE_OVERRIDES={"recipe_goat_cheese":false}

# Global hotkeys (active even when the terminal isn't focused) to
# pause/resume and quit the bot loop.
FMV_PAUSE_HOTKEY=f9
FMV_QUIT_HOTKEY=f10

# Start paused (press FMV_PAUSE_HOTKEY to begin) instead of acting
# immediately. Runtime discovery and internal actions begin on resume.
FMV_START_PAUSED=true

FMV_LOG_LEVEL=INFO

# Optional Discord notifications. Routine actions are collected into an hourly
# summary; lifecycle events and important failures are delivered immediately.
# One status message is edited at the configured cadence and moved to the end
# only after another webhook message is posted. Set the status interval to 0 to
# disable periodic edits while retaining event-driven status updates.
# Keep this URL private because it contains the Discord webhook token.
# FMV_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
FMV_WEBHOOK_SUMMARY_INTERVAL=3600
FMV_WEBHOOK_STATUS_INTERVAL=60

# Overlay GUI (see src/farm_merge_valet/gui/overlay.py) -- an optional log
# viewer, off by default. FMV_GUI_OVERLAY_MODE makes it always-on-top and
# click-through *while inactive* (alt-tab/click its taskbar entry to
# interact with it normally); disable it for a plain window instead.
# FMV_GUI_OPACITY is 0 (fully transparent) - 1 (fully opaque).
FMV_GUI_ENABLED=false
FMV_GUI_OPACITY=0.85
FMV_GUI_OVERLAY_MODE=true
